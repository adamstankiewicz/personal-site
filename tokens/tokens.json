{
  "color": {
    "chart": {
      "cream": { "$type": "color", "$value": "#f4efdf" },
      "cream-raised": { "$type": "color", "$value": "#ece5d0" },
      "contour": { "$type": "color", "$value": "#c9bc9c" },
      "brown": { "$type": "color", "$value": "#8a7a58" }
    },
    "inkwell": {
      "900": { "$type": "color", "$value": "#2a2620" },
      "500": { "$type": "color", "$value": "#6e6553" }
    },
    "night": {
      "950": { "$type": "color", "$value": "#101318" },
      "900": { "$type": "color", "$value": "#171c24" },
      "700": { "$type": "color", "$value": "#2b3341" },
      "300": { "$type": "color", "$value": "#8d95a5" },
      "100": { "$type": "color", "$value": "#e4e4da" }
    },
    "magenta": {
      "600": { "$type": "color", "$value": "#b81375" },
      "400": { "$type": "color", "$value": "#f0549f" }
    },
    "blue": {
      "600": { "$type": "color", "$value": "#1d5da8" },
      "300": { "$type": "color", "$value": "#7fb2e8" }
    }
  },
  "semantic": {
    "paper": {
      "$type": "color",
      "$value": "{color.chart.cream}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.950}" }
    },
    "paper-raised": {
      "$type": "color",
      "$value": "{color.chart.cream-raised}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.900}" }
    },
    "line": {
      "$type": "color",
      "$value": "{color.chart.contour}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.700}" }
    },
    "line-strong": {
      "$type": "color",
      "$value": "{color.inkwell.900}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.100}" }
    },
    "ink": {
      "$type": "color",
      "$value": "{color.inkwell.900}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.100}" }
    },
    "ink-muted": {
      "$type": "color",
      "$value": "{color.inkwell.500}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.300}" }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.magenta.600}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.magenta.400}" }
    },
    "accent-2": {
      "$type": "color",
      "$value": "{color.blue.600}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.blue.300}" }
    }
  },
  "font": {
    "serif": {
      "$type": "fontFamily",
      "$value": "var(--font-archivo), \"Archivo\", \"Helvetica Neue\", Arial, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "var(--font-plex-mono), ui-monospace, \"SFMono-Regular\", Menlo, monospace"
    }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "open": { "$type": "duration", "$value": "320ms" },
    "slow": { "$type": "duration", "$value": "560ms" }
  },
  "easing": {
    "out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "spring": {
      "$type": "cubicBezier",
      "$value": "linear(0, 0.317 5.6%, 0.604 11.2%, 0.83 16.9%, 0.985 22.7%, 1.062 28.6%, 1.078 33%, 1.056 39.4%, 1.007 50.4%, 0.988 59.7%, 0.996 74.4%, 1)"
    }
  }
}
