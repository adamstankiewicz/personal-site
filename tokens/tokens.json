{
  "color": {
    "cream": {
      "100": { "$type": "color", "$value": "#f5f2ea" },
      "200": { "$type": "color", "$value": "#efebe0" },
      "300": { "$type": "color", "$value": "#d8d2c2" }
    },
    "ink": {
      "500": { "$type": "color", "$value": "#6e6759" },
      "900": { "$type": "color", "$value": "#211d16" }
    },
    "char": {
      "700": { "$type": "color", "$value": "#353028" },
      "900": { "$type": "color", "$value": "#1e1b17" },
      "950": { "$type": "color", "$value": "#171512" }
    },
    "bone": {
      "100": { "$type": "color", "$value": "#e9e4d8" },
      "500": { "$type": "color", "$value": "#948d7e" }
    },
    "rust": {
      "400": { "$type": "color", "$value": "#e0693c" },
      "600": { "$type": "color", "$value": "#b4441f" }
    }
  },
  "semantic": {
    "paper": {
      "$type": "color",
      "$value": "{color.cream.100}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.char.950}" }
    },
    "paper-raised": {
      "$type": "color",
      "$value": "{color.cream.200}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.char.900}" }
    },
    "line": {
      "$type": "color",
      "$value": "{color.cream.300}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.char.700}" }
    },
    "line-strong": {
      "$type": "color",
      "$value": "{color.ink.900}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.bone.100}" }
    },
    "ink": {
      "$type": "color",
      "$value": "{color.ink.900}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.bone.100}" }
    },
    "ink-muted": {
      "$type": "color",
      "$value": "{color.ink.500}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.bone.500}" }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.rust.600}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.rust.400}" }
    }
  },
  "font": {
    "serif": {
      "$type": "fontFamily",
      "$value": "var(--font-newsreader), \"Iowan Old Style\", Georgia, serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "var(--font-geist-mono), ui-monospace, \"SFMono-Regular\", Menlo, monospace"
    }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "open": { "$type": "duration", "$value": "320ms" },
    "slow": { "$type": "duration", "$value": "560ms" }
  },
  "easing": {
    "out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "spring": {
      "$type": "cubicBezier",
      "$value": "linear(0, 0.317 5.6%, 0.604 11.2%, 0.83 16.9%, 0.985 22.7%, 1.062 28.6%, 1.078 33%, 1.056 39.4%, 1.007 50.4%, 0.988 59.7%, 0.996 74.4%, 1)"
    }
  }
}
