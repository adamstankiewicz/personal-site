{
  "color": {
    "gray": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f6f6f7" },
      "200": { "$type": "color", "$value": "#e7e7e9" },
      "500": { "$type": "color", "$value": "#5f5f67" },
      "900": { "$type": "color", "$value": "#131316" }
    },
    "night": {
      "950": { "$type": "color", "$value": "#0d0e11" },
      "900": { "$type": "color", "$value": "#17181c" },
      "700": { "$type": "color", "$value": "#292a30" },
      "300": { "$type": "color", "$value": "#a0a2ac" },
      "50": { "$type": "color", "$value": "#f1f1f3" }
    },
    "cobalt": {
      "700": { "$type": "color", "$value": "#0f28b3" },
      "600": { "$type": "color", "$value": "#1435e5" },
      "300": { "$type": "color", "$value": "#8b9dff" }
    }
  },
  "semantic": {
    "paper": {
      "$type": "color",
      "$value": "{color.gray.0}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.950}" }
    },
    "paper-raised": {
      "$type": "color",
      "$value": "{color.gray.50}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.900}" }
    },
    "line": {
      "$type": "color",
      "$value": "{color.gray.200}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.700}" }
    },
    "line-strong": {
      "$type": "color",
      "$value": "{color.gray.900}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.50}" }
    },
    "ink": {
      "$type": "color",
      "$value": "{color.gray.900}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.50}" }
    },
    "ink-muted": {
      "$type": "color",
      "$value": "{color.gray.500}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.night.300}" }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.cobalt.600}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.cobalt.300}" }
    },
    "accent-strong": {
      "$type": "color",
      "$value": "{color.cobalt.700}",
      "$extensions": { "dev.adamstankiewicz.dark": "{color.cobalt.300}" }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": "var(--font-bricolage), \"Bricolage Grotesque\", \"Archivo\", \"Helvetica Neue\", Arial, sans-serif"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "var(--font-archivo), \"Archivo\", \"Helvetica Neue\", Arial, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "var(--font-plex-mono), ui-monospace, \"SFMono-Regular\", Menlo, monospace"
    }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "3px" },
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "base": { "$type": "duration", "$value": "200ms" },
    "open": { "$type": "duration", "$value": "320ms" },
    "slow": { "$type": "duration", "$value": "560ms" }
  },
  "easing": {
    "out": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "spring": {
      "$type": "cubicBezier",
      "$value": "linear(0, 0.317 5.6%, 0.604 11.2%, 0.83 16.9%, 0.985 22.7%, 1.062 28.6%, 1.078 33%, 1.056 39.4%, 1.007 50.4%, 0.988 59.7%, 0.996 74.4%, 1)"
    }
  }
}
