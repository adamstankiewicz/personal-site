{
  "name": "adamstankiewicz-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "buildinfo": "node scripts/build-info.mjs",
    "dev": "npm run tokens && npm run buildinfo && next dev",
    "build": "npm run tokens:check && npm run buildinfo && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.79",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
