{
  "name": "adamstankiewicz-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "buildinfo": "node scripts/build-info.mjs",
    "ghstats": "node scripts/build-gh-stats.mjs",
    "dev": "npm run tokens && npm run buildinfo && npm run ghstats && next dev",
    "build": "npm run tokens:check && npm run buildinfo && npm run ghstats && next build",
    "lint": "eslint .",
    "test": "node --test scripts/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.79",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "torph": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
